*.engine

# Secrets + runtime DB (NEVER commit these)
monitor_config.json
*.sqlite
*.sqlite3

# Local run/test logs
*.log

# Worker <-> dashboard runtime control/handoff files (regenerated at runtime)
monitor_control.json
monitor_latest.json
monitor_latest_frame.jpg
monitor_upload_request.json
monitor_upload_result.json
*.tmp

# model backups (kept locally, not committed)
*.pretrain.bak
